  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "전체 추이",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "판 수 추이(진입 · 클리어 · 실패)",
      "description": "진입 − 클리어 − 실패 = **이탈**(보고 없이 사라진 판). 세 선의 간격이 그 규모다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, sum(enter_count) AS \"진입\"\nFROM stage_enter_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, sum(clear_count) AS \"클리어\"\nFROM stage_clear_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, sum(fail_count) AS \"실패\"\nFROM stage_fail_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "실패율 · 이탈율",
      "description": "실패율 = 실패/진입(실질 난이도), 이탈율 = (진입−클리어−실패)/진입.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), e.bucket, 'Asia/Seoul') AS time,\n       round(sum(coalesce(f.fail_count, 0))::numeric / nullif(sum(e.enter_count), 0), 4) AS \"실패율\",\n       round(greatest(sum(e.enter_count) - sum(coalesce(c.clear_count, 0))\n             - sum(coalesce(f.fail_count, 0)), 0)::numeric\n             / nullif(sum(e.enter_count), 0), 4) AS \"이탈율\"\nFROM stage_enter_daily e\nLEFT JOIN stage_clear_daily c ON c.bucket = e.bucket AND c.stage_id = e.stage_id\nLEFT JOIN stage_fail_daily f ON f.bucket = e.bucket AND f.stage_id = e.stage_id\nWHERE $__timeFilter(e.bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "스테이지별 난이도 — 리밸런싱 후보",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "스테이지별 진입 · 클리어 · 실패 · 이탈",
      "description": "실패율 높은 순 50개. 평균값은 일별 평균을 실패 건수로 가중해 합산한 값이다(단순 평균의 평균이 아니다). 잔여 적이 많고 실패가 이르면 스탯 벽, 적으면서 오래 끌면 DPS 부족이다(5.3).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.stage_id AS \"스테이지\",\n       sum(e.enter_count) AS \"진입\",\n       sum(coalesce(c.clear_count, 0)) AS \"클리어\",\n       sum(coalesce(f.fail_count, 0)) AS \"실패\",\n       greatest(sum(e.enter_count) - sum(coalesce(c.clear_count, 0))\n                - sum(coalesce(f.fail_count, 0)), 0) AS \"이탈\",\n       round(sum(coalesce(f.fail_count, 0))::numeric / nullif(sum(e.enter_count), 0), 4) AS \"실패율\",\n       round(sum(coalesce(f.avg_elapsed_ms * f.fail_count, 0))\n             / nullif(sum(coalesce(f.fail_count, 0)), 0) / 1000.0, 1) AS \"실패 평균 지속(초)\",\n       round(sum(coalesce(f.avg_remaining_monster_count * f.fail_count, 0))\n             / nullif(sum(coalesce(f.fail_count, 0)), 0), 2) AS \"실패 시 잔여 적\",\n       round(sum(coalesce(f.reached_boss_count, 0))::numeric\n             / nullif(sum(coalesce(f.fail_count, 0)), 0), 3) AS \"보스 도달 비율\"\nFROM stage_enter_daily e\nLEFT JOIN stage_clear_daily c ON c.bucket = e.bucket AND c.stage_id = e.stage_id\nLEFT JOIN stage_fail_daily f ON f.bucket = e.bucket AND f.stage_id = e.stage_id\nWHERE $__timeFilter(e.bucket)\nGROUP BY e.stage_id\nHAVING sum(e.enter_count) > 0\nORDER BY \"실패율\" DESC NULLS LAST, \"진입\" DESC\nLIMIT 50",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "보상 · 성장",
      "collapsed": false,
      "gridPos": {
        "h": 1,
