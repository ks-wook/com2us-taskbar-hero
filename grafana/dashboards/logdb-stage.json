          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       round(count(*) FILTER (WHERE is_capped)::numeric / nullif(count(*), 0), 3) AS \"상한 도달률\"\nFROM offline_claim_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
