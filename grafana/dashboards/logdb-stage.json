        "y": 21
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "스테이지 보상 유입(골드 · 경험치)",
      "description": "클리어 보상 총량. 골드는 원장(currency_flow_logs)에도 남지만 여기서는 스테이지 몫만 본다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, sum(gold_sum) AS \"골드\", sum(exp_sum) AS \"경험치\"\nFROM stage_clear_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "레벨업 건수(출처별)",
      "description": "stage / offline 중 어디서 성장하는가(5.3). 방치 비중이 과하면 전투 동기가 약하다는 신호다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       source AS metric, count(*) AS value\nFROM character_levelup_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
