          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH top AS (\n    SELECT item_code\n    FROM item_supply_history\n    WHERE $__timeFilter(log_date)\n    GROUP BY item_code\n    ORDER BY max(total_count) DESC\n    LIMIT 8\n)\nSELECT (log_date::timestamp AT TIME ZONE 'Asia/Seoul') AS time,\n       h.item_code::text AS metric,\n       sum(h.total_count) AS value\nFROM item_supply_history h\nJOIN top t ON t.item_code = h.item_code\nWHERE $__timeFilter(h.log_date)\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
