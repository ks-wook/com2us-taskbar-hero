    {
      "id": 5,
      "type": "timeseries",
      "title": "유통 골드 총량 · 우편함 미수령",
      "description": "총량은 **재고**라 구간 안에서 더하면 안 된다 — TimescaleDB의 last()로 그 구간 마지막 스냅샷을 고른다. 원장(경제 대시보드)의 순증과 겹쳐 보면 \"유입이 많은데 총량이 안 늘었다(=소각이 받치고 있다)\"를 가를 수 있다(7장).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       last(total_amount, \"timestamp\") AS \"유통 총량\",\n       last(mail_pending_amount, \"timestamp\") AS \"우편함 미수령(부채)\"\nFROM currency_supply_history\nWHERE $__timeFilter(\"timestamp\") AND currency_code = 1\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "계정당 평균 보유 골드 · 보유 계정 수",
      "description": "총량이 늘어도 평균 보유가 그대로면 상위 계정에만 쌓인다는 뜻이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       round(last(total_amount, \"timestamp\")::numeric\n             / nullif(last(holder_count, \"timestamp\"), 0)) AS \"계정당 평균 보유\",\n       last(holder_count, \"timestamp\") AS \"보유 계정 수\"\nFROM currency_supply_history\nWHERE $__timeFilter(\"timestamp\") AND currency_code = 1\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
