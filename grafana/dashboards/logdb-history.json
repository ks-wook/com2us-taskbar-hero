    {
      "id": 2,
      "type": "timeseries",
      "title": "동시 접속자 추이",
      "description": "5분 주기 스냅샷(7장). 집계 단위를 5분으로 두면 원본 해상도, 1시간·1일로 올리면 그 구간의 평균과 피크를 함께 본다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       round(avg(online_count)) AS \"평균 동접\",\n       max(online_count) AS \"최대 동접\"\nFROM online_user_history\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
