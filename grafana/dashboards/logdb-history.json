    {
      "id": 8,
      "type": "timeseries",
      "title": "시세 추이(매물 많은 상위 5 품목)",
      "description": "1시간 주기 호가 스냅샷이라 **체결이 없는 품목도 시세가 남는다**(체결 로그만으로는 보이지 않는 수요다, 7장).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH top AS (\n    SELECT item_code\n    FROM trade_market_history\n    WHERE $__timeFilter(\"timestamp\")\n    GROUP BY item_code\n    ORDER BY sum(listing_count) DESC\n    LIMIT 5\n)\nSELECT time_bucket(INTERVAL '$bucket', h.\"timestamp\", 'Asia/Seoul') AS time,\n       h.item_code::text AS metric,\n       round(avg(h.avg_price)) AS value\nFROM trade_market_history h\nJOIN top t ON t.item_code = h.item_code\nWHERE $__timeFilter(h.\"timestamp\")\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "품목별 최신 매물 · 호가",
      "description": "선택 구간의 **가장 최근 스냅샷** 한 줄씩. 매물이 쌓이면서 최저가가 내려가면 그 품목은 공급 과잉이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (item_code)\n       item_code AS \"아이템 코드\",\n       listing_count AS \"매물 수\",\n       min_price AS \"최저가\",\n       avg_price AS \"평균 호가\",\n       \"timestamp\" AS \"스냅샷 시각\"\nFROM trade_market_history\nWHERE $__timeFilter(\"timestamp\")\nORDER BY item_code, \"timestamp\" DESC",
          "editorMode": "code"
