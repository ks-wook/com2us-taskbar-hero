{
  "uid": "logdb-session",
  "title": "1. 접속 · 리텐션",
  "description": "세션 개시(save.load)와 캐릭터 생성 로그. 계정 서버는 이 체계에 로그를 내지 않으므로(5.1) 접속·리텐션은 전부 save_load_logs에서 나온다.",
  "tags": [
    "logdb",
    "게임로그"
  ],
  "timezone": "Asia/Seoul",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timepicker": {
    "time_options": [
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d",
      "90d"
    ],
    "refresh_intervals": [
      "1m",
      "5m",
      "10m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "집계 단위",
        "description": "추이 그래프의 묶음 단위. 원본 테이블 패널은 이 값을 그대로 쓰고, 연속 집계 패널은 1일이 하한이다(8.10).",
        "type": "custom",
        "query": "5 minutes,1 hour,6 hours,1 day,7 days",
        "current": {
          "selected": true,
          "text": "1 day",
          "value": "1 day"
        },
        "options": [
          {
            "selected": false,
            "text": "5 minutes",
            "value": "5 minutes"
          },
          {
            "selected": false,
            "text": "1 hour",
            "value": "1 hour"
          },
          {
            "selected": false,
            "text": "6 hours",
            "value": "6 hours"
          },
          {
            "selected": true,
            "text": "1 day",
            "value": "1 day"
          },
          {
            "selected": false,
            "text": "7 days",
            "value": "7 days"
          }
        ],
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "서버 기동·종료",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "logdb"
        },
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT \"timestamp\" AS time, phase AS text, version AS tags\nFROM server_lifecycle_logs\nWHERE $__timeFilter(\"timestamp\")\nORDER BY 1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "접속 규모",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "활성 유저(집계 단위별 · DAU/WAU)",
      "description": "(날짜, uid)로 그룹한 연속 집계 session_user_daily를 **한 번 더 세어** 얻는다 — 연속 집계는 count(distinct)를 지원하지 않아 뷰를 그렇게 만들어 뒀다(8.10). 집계 단위를 1일로 두면 DAU, 7일로 두면 WAU다(단위 안에서 중복 계정을 걷어낸다).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, count(DISTINCT uid) AS \"활성 유저\"\nFROM session_user_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "세션 수 · 유저당 평균 세션",
      "description": "세션 수가 활성 유저보다 크게 벌어지면 재접속(끊김·앱 전환)이 잦다는 뜻이다. 평균 세션은 집계 단위를 늘려도 **(계정, 하루) 기준 평균**이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, sum(session_count) AS \"세션 수\"\nFROM session_user_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, round(avg(session_count), 2) AS \"유저당 평균 세션(하루)\"\nFROM session_user_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "신규 유입 / 복귀",
      "description": "is_new = 첫 접속(세이브 신규 생성) = 신규 유입(8.2).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       count(*) FILTER (WHERE is_new) AS \"신규(세이브 생성)\",\n       count(*) FILTER (WHERE NOT is_new AND offline_elapsed_sec >= 604800) AS \"7일 이상 만의 복귀\"\nFROM save_load_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "이탈 후 경과 시간 분포(접속 시점)",
      "description": "직전 접속 이후 경과(offline_elapsed_sec). 방치형이라 이 값이 곧 재방문 주기다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       round(avg(offline_elapsed_sec) / 3600.0, 2) AS \"평균(시간)\",\n       round((percentile_cont(0.5) WITHIN GROUP (ORDER BY offline_elapsed_sec))::numeric\n             / 3600.0, 2) AS \"중앙값(시간)\"\nFROM save_load_logs\nWHERE $__timeFilter(\"timestamp\") AND NOT is_new\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "리텐션",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "D+1 · D+7 재접속",
      "description": "같은 뷰의 자기 조인으로 낸다(8.10). 조회 구간의 마지막 1·7일은 아직 미래가 안 와서 낮게 보인다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT d0.bucket AS \"날짜\",\n       count(*) AS \"그날 접속자\",\n       count(d1.uid) AS \"D+1 재접속\",\n       count(d7.uid) AS \"D+7 재접속\",\n       round(count(d1.uid)::numeric / nullif(count(*), 0), 3) AS \"D+1 유지율\",\n       round(count(d7.uid)::numeric / nullif(count(*), 0), 3) AS \"D+7 유지율\"\nFROM session_user_daily d0\nLEFT JOIN session_user_daily d1 ON d1.uid = d0.uid AND d1.bucket = d0.bucket + INTERVAL '1 day'\nLEFT JOIN session_user_daily d7 ON d7.uid = d0.uid AND d7.bucket = d0.bucket + INTERVAL '7 days'\nWHERE $__timeFilter(d0.bucket)\nGROUP BY d0.bucket\nORDER BY d0.bucket DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "캐릭터 생성",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "첫 직업 분포",
      "description": "첫 캐릭터로 고른 직업(5.2). 한쪽으로 쏠리면 직업 소개·초기 체감이 기울어 있다는 신호다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT class_code::text AS metric, count(*) AS value\nFROM player_create_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY class_code\nORDER BY 2 DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "성별 분포",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE gender WHEN 1 THEN '남' WHEN 2 THEN '여' ELSE gender::text END AS metric,\n       count(*) AS value\nFROM player_create_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY gender\nORDER BY 2 DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        }
      }
    }
  ]
}
