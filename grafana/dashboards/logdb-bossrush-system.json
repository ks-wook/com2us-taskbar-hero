          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "배치 처리량",
      "description": "배치 종류를 테이블이 아니라 batch_key로 구분한다(5.11).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
