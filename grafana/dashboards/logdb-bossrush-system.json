      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       error_code::text AS metric, count(*) AS value\nFROM bossrush_clear_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code <> 0\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ],
