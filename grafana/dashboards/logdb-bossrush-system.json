        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "배치 실패 · 소요",
      "description": "스킵은 다른 인스턴스가 리더 락을 잡은 정상 동작이다 — 실패만 신호로 본다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT batch_key AS \"배치\",\n       count(*) AS \"주기 수\",\n       sum(processed) AS \"처리\",\n       sum(skipped) AS \"스킵\",\n       sum(failed) AS \"실패\",\n       round(avg(elapsed_ms)) AS \"평균 소요(ms)\",\n       max(elapsed_ms) AS \"최대 소요(ms)\"\nFROM batch_run_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY batch_key\nORDER BY \"실패\" DESC, \"처리\" DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
