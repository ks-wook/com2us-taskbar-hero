            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       batch_key AS metric, sum(processed) AS value\nFROM batch_run_logs\nWHERE $__timeFilter(\"timestamp\")\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
