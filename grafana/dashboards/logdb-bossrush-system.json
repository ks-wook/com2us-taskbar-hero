    {
      "id": 2,
      "type": "timeseries",
      "title": "도전 · 완주",
      "description": "enter와 clear를 짝지어 완주율을 낸다(5.10). 진입 거부는 해금 미달·정산 창이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time, count(*) AS \"도전\"\nFROM bossrush_enter_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time, count(*) AS \"완주 보고\"\nFROM bossrush_clear_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       count(*) AS \"진입 거부\"\nFROM bossrush_enter_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code <> 0\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "라운드별 평균 소요 — 병목",
      "description": "라운드 5개가 컬럼으로 펼쳐져 있어(8.6) 어느 라운드가 병목인지 바로 보인다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT '1라운드' AS \"라운드\", round(avg(round1_ms) / 1000.0, 1) AS \"평균 소요(초)\"\nFROM bossrush_clear_logs WHERE $__timeFilter(\"timestamp\") AND error_code = 0\nUNION ALL\nSELECT '2라운드', round(avg(round2_ms) / 1000.0, 1)\nFROM bossrush_clear_logs WHERE $__timeFilter(\"timestamp\") AND error_code = 0\nUNION ALL\nSELECT '3라운드', round(avg(round3_ms) / 1000.0, 1)\nFROM bossrush_clear_logs WHERE $__timeFilter(\"timestamp\") AND error_code = 0\nUNION ALL\nSELECT '4라운드', round(avg(round4_ms) / 1000.0, 1)\nFROM bossrush_clear_logs WHERE $__timeFilter(\"timestamp\") AND error_code = 0\nUNION ALL\nSELECT '5라운드', round(avg(round5_ms) / 1000.0, 1)\nFROM bossrush_clear_logs WHERE $__timeFilter(\"timestamp\") AND error_code = 0",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "시즌별 기록 분포",
      "description": "시즌이 진행될수록 평균이 내려가면(빨라지면) 성장 곡선이 콘텐츠를 앞지르고 있다는 뜻이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT season_id AS \"시즌\",\n       count(*) AS \"완주 보고\",\n       count(DISTINCT uid) AS \"참가 계정\",\n       round(min(clear_ms) / 1000.0, 1) AS \"최고 기록(초)\",\n       round(avg(clear_ms) / 1000.0, 1) AS \"평균 기록(초)\",\n       count(*) FILTER (WHERE is_new_record) AS \"기록 갱신\"\nFROM bossrush_clear_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0\nGROUP BY season_id\nORDER BY season_id DESC",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "클리어 보고 거부",
      "description": "닫힌 런에 온 보고(런 수명 초과)가 반복되면 런 수명이 실제 플레이 시간보다 짧다는 신호다(5.10).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
