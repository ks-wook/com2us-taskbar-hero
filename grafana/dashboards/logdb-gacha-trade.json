    {
      "id": 6,
      "type": "timeseries",
      "title": "등록 · 결말 추이",
      "description": "등록 1건은 결말 1건으로만 끝난다(8.5). 만료가 늘면 공급 과잉이거나 가격이 높다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time, count(*) AS \"등록\"\nFROM trade_register_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       CASE outcome WHEN 'buy' THEN '체결' WHEN 'cancel' THEN '취소' ELSE '만료' END AS metric,\n       count(*) AS value\nFROM trade_close_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
