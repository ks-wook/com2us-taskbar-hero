          "rawSql": "SELECT time_bucket(INTERVAL '$bucket', \"timestamp\", 'Asia/Seoul') AS time,\n       sum(price) AS \"거래 대금\",\n       sum(fee) AS \"수수료(소각)\",\n       sum(seller_proceeds) AS \"판매자 수령\"\nFROM trade_close_logs\nWHERE $__timeFilter(\"timestamp\") AND error_code = 0 AND outcome = 'buy'\nGROUP BY 1\nORDER BY 1",
