      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time, '등급 ' || grade::text AS metric, sum(pull_count) AS value\nFROM gacha_grade_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1, 2\nORDER BY 1",
          "editorMode": "code"
