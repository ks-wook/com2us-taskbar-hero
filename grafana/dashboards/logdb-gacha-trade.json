    {
      "id": 8,
      "type": "table",
      "title": "품목별 시세 · 유동성",
      "description": "listing_id로 등록 행과 결말 행을 잇는다(8.9의 listing_id 인덱스가 이 조인을 받는다). 체결 시간이 길수록 그 품목은 공급 과잉이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.item_code AS \"아이템 코드\",\n       count(*) AS \"등록\",\n       round(avg(r.price)) AS \"평균 등록가\",\n       round(avg(r.price::numeric / nullif(r.base_price, 0)), 3) AS \"기준가 대비\",\n       count(c.listing_id) FILTER (WHERE c.outcome = 'buy') AS \"체결\",\n       round(avg(c.listed_sec) FILTER (WHERE c.outcome = 'buy') / 3600.0, 2) AS \"평균 체결 시간(시간)\"\nFROM trade_register_logs r\nLEFT JOIN trade_close_logs c ON c.listing_id = r.listing_id\nWHERE $__timeFilter(r.\"timestamp\") AND r.error_code = 0\nGROUP BY r.item_code\nORDER BY \"등록\" DESC\nLIMIT 30",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
