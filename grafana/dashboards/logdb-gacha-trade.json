    {
      "id": 2,
      "type": "table",
      "title": "배너별 등급 실측 분포",
      "description": "마스터의 설계 확률과 이 비율이 벌어지면 뽑기 테이블이나 구현을 의심한다(5.6).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gacha_code AS \"배너\",\n       grade AS \"등급\",\n       sum(pull_count) AS \"개수\",\n       round(sum(pull_count)::numeric\n             / nullif(sum(sum(pull_count)) OVER (PARTITION BY gacha_code), 0), 5) AS \"실측 비율\",\n       sum(pity_count) AS \"천장 발동\"\nFROM gacha_grade_daily\nWHERE $__timeFilter(bucket)\nGROUP BY gacha_code, grade\nORDER BY gacha_code, grade",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "등급별 획득 추이",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
