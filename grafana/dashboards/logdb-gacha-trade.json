    {
      "id": 4,
      "type": "timeseries",
      "title": "천장 발동 비율",
      "description": "천장에 의존해 최고 등급을 얻고 있다면 확률이 체감보다 낮다는 뜻이다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "logdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "logdb"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket(GREATEST(INTERVAL '$bucket', INTERVAL '1 day'), bucket, 'Asia/Seoul') AS time,\n       round(sum(pity_count)::numeric / nullif(sum(pull_count), 0), 4) AS \"천장 발동 비율\"\nFROM gacha_grade_daily\nWHERE $__timeFilter(bucket)\nGROUP BY 1\nORDER BY 1",
          "editorMode": "code"
        }
      ],
