@GameServer_HostAddress = http://localhost:5247

# 아래 요청은 모두 인증 필요: body의 userId·token을 AccountServer 로그인 응답값으로 채운다.
@userId = 1
@token = <AccountServer 로그인 응답의 token 붙여넣기>

### 코어 세이브 로드(신규는 { isNew:true }. 고정 크기 데이터 전량 — 가방 아이템은 제외)
POST {{GameServer_HostAddress}}/api/game/load
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {}
}

### 가방 아이템 첫 페이지(cursor=-1)
POST {{GameServer_HostAddress}}/api/game/inventory/list
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "cursor": -1, "limit": 200 }
}

### 가방 아이템 다음 페이지(직전 응답의 nextCursor를 그대로 넣는다. hasMore=false면 끝)
POST {{GameServer_HostAddress}}/api/game/inventory/list
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "cursor": 199, "limit": 200 }
}

### 캐릭터 생성(최초는 nickname+classCode+gender, 이후는 classCode+gender만. gender 1:남 2:여, 생략 시 1)
POST {{GameServer_HostAddress}}/api/game/create-character
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "nickname": "hero", "classCode": 1, "gender": 1 }
}

### 파티 편성 저장 — 저장 후의 파티 전체(스냅샷)를 1회로 반영. 목록에 없는 보유 캐릭터는 미편성이 된다
POST {{GameServer_HostAddress}}/api/game/party/arrange
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {
    "members": [
      { "characterId": 3, "slot": 1 },
      { "characterId": 4, "slot": 2 },
      { "characterId": 1, "slot": 3 }
    ]
  }
}

### 접속 시각 갱신(heartbeat, 클라가 5분 주기 호출)
POST {{GameServer_HostAddress}}/api/game/update-last-active
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {}
}

### 오프라인 보상 정산(경과·보상은 서버 계산, data 없음)
# 경과 10분 미만이면 3001(200 OK), 동시 중복이면 3002(409). heartbeat보다 먼저 호출할 것.
POST {{GameServer_HostAddress}}/api/game/offline/claim
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {}
}

###

### 이번달 출석 현황 조회(서버 KST 기준 달력, 상태 변경 없음)
POST {{GameServer_HostAddress}}/api/game/attendance/status
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {}
}

### 출석 보상 획득(하루 1회, 보상은 메일로 발급 — 이미 수령이면 9001(409))
POST {{GameServer_HostAddress}}/api/game/attendance/claim
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": {}
}

###

### 소모품 사용(1회 1개 고정 — 버프 부여·연장. 누적 24시간 초과면 4021, 소모품 아니면 4020)
POST {{GameServer_HostAddress}}/api/game/consumable/use
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "itemId": 1 }
}

### 적용 중인 버프 조회(버프 UI 재동기화용 경량 조회, data 없음 — 없으면 빈 배열 + 성공)
POST {{GameServer_HostAddress}}/api/game/consumable/buffs
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}"
}

### 스테이지 진입(도달 가능 검증 — 스킵 진입은 6002. 응답에 스폰·보스·배경타입)
POST {{GameServer_HostAddress}}/api/game/stage/enter
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "act": 1, "difficulty": 1, "stage": 1 }
}

### 스테이지 클리어(보상은 서버 산출 — 현재 진입 스테이지와 불일치면 6003)
POST {{GameServer_HostAddress}}/api/game/stage/clear
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "act": 1, "difficulty": 1, "stage": 1 }
}

### 스테이지 실패 보고(기록 전용 — 진행도·보상 불변. 미진입이면 6003, 음수 보고면 1006)
POST {{GameServer_HostAddress}}/api/game/stage/fail
Content-Type: application/json

{
  "userId": {{userId}},
  "token": "{{token}}",
  "data": { "act": 1, "difficulty": 1, "stage": 1, "elapsedMs": 41200, "remainingMonsterCount": 2, "reachedBoss": true }
}

### [관리] 보스러시 랭킹 캐시 최초 적재(게임 토큰 아님 — X-Admin-Key 헤더. 평소에는 server_up.py가 호출한다)
POST {{GameServer_HostAddress}}/api/admin/boss-rush/rank/warmup
X-Admin-Key: taskbar_hero_dev_admin

### [관리] 같은 적재를 강제로(리더보드가 이미 채워져 있어도 MySQL에서 다시 적재)
POST {{GameServer_HostAddress}}/api/admin/boss-rush/rank/warmup?force=true
X-Admin-Key: taskbar_hero_dev_admin

###
