<Project Sdk="Microsoft.NET.Sdk">

  <!--
    서버-클라이언트 공통 라이브러리.
    Unity 클라이언트(com2us-taskbar-hero-client)와 소스를 공유하기 위해 netstandard2.0을 타깃팅한다.
    CLAUDE.md 규칙: implicit usings / nullable 비활성화, 서버 전용 의존성 추가 금지.
    빌드 산출물(obj/bin)은 Directory.Build.props에서 폴더 밖(../artifacts)으로 재배치한다
    (Unity가 로컬 패키지로 이 폴더의 .cs를 직접 컴파일하므로 생성 .cs 중복 컴파일 방지).
  -->
  <PropertyGroup>
    <!--
      멀티 타겟: netstandard2.0(Unity 클라이언트 공유 소스용) + net10.0(서버 참조용).
      Unity는 이 폴더의 소스를 asmdef로 직접 컴파일하므로 TFM 목록과 무관하다.
      서버(net10.0)가 동일 TFM(net10.0)의 Common 출력을 참조하게 되어, dotnet watch의
      교차 TFM 상관 경고("일치하는 메타데이터 참조가 없는 프로젝트 참조")가 사라진다.
    -->
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>TaskbarHero.Common</RootNamespace>
    <AssemblyName>TaskbarHero.Common</AssemblyName>
    <!-- Unity 전용 파일이 .NET 컴파일에 끼어들지 않게 명시적으로 제외 -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

</Project>
